// =============================================================================
// Частина 4 — Виявлення супервузлів
//   cat queries/part4_supernodes.cypher | docker exec -i neo4j_movielens \
//        cypher-shell -u neo4j -p password123
// =============================================================================

// -----------------------------------------------------------------------------
// Крок 1. Вузли з аномально великою кількістю ребер (degree).
// COUNT { (n)--() } — форма count-subquery у Neo4j 5.x (замінила застаріле
// size((n)--())). Рахує всі інцидентні ребра незалежно від напрямку й типу.
// -----------------------------------------------------------------------------
MATCH (n)
RETURN labels(n) AS labels,
       coalesce(n.name, n.title, 'User ' + toString(n.userId)) AS node,
       COUNT { (n)--() } AS degree
ORDER BY degree DESC
LIMIT 20;

// -----------------------------------------------------------------------------
// Розбивка degree за лейблами — показує, що Genre-вузли мають екстремальний
// degree (кожен жанр звʼязаний із сотнями-тисячами фільмів), при цьому їх лише 18.
// -----------------------------------------------------------------------------
MATCH (g:Genre)
RETURN g.name AS genre, COUNT { (g)<-[:HAS_GENRE]-() } AS movieCount
ORDER BY movieCount DESC;

// -----------------------------------------------------------------------------
// Найактивніші користувачі (за кількістю оцінок) — вторинні супервузли.
// -----------------------------------------------------------------------------
MATCH (u:User)
RETURN u.userId AS userId, COUNT { (u)-[:RATED]->() } AS ratingsGiven
ORDER BY ratingsGiven DESC
LIMIT 10;

// -----------------------------------------------------------------------------
// Найпопулярніші фільми (за кількістю отриманих оцінок) — теж супервузли.
// -----------------------------------------------------------------------------
MATCH (m:Movie)
RETURN m.title AS title, COUNT { (m)<-[:RATED]-() } AS ratingsReceived
ORDER BY ratingsReceived DESC
LIMIT 10;
